# Pilgrim — Root Environment Variables (used by docker-compose)
# Copy this file to .env and update values

# Application
PILGRIM_ENVIRONMENT=local
PILGRIM_DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://pilgrim:pilgrim@postgres:5432/pilgrim
POSTGRES_USER=pilgrim
POSTGRES_PASSWORD=pilgrim
POSTGRES_DB=pilgrim

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_SOFT_TIME_LIMIT=300
CELERY_TIME_LIMIT=360

# Scrapling
PILGRIM_SCRAPLING_BROWSER_INSTALL=false

# ── API auth ─────────────────────────────────────────────────────
# read-open (default): reads stay public, mutations need a bearer token.
# strict: everything (except /auth/login + /health/*) needs a token.
PILGRIM_AUTH_MODE=read-open
# HS256 secret for login JWTs.  When set it must be >= 32 bytes (enforced
# at startup); when unset a built-in placeholder is used with a LOUD startup
# warning — and strict auth mode refuses to start on it.  Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# PILGRIM_JWT_SECRET=
PILGRIM_JWT_TTL_SECONDS=3600

# ── Rate limit (POST /scrape/, POST /crawl/jobs, POST /auth/login) ─
# Each endpoint family has its own per-IP bucket (scrape / crawl / auth).
# redis = shared counter (recommended), memory = per-process, off = none.
PILGRIM_RATE_LIMIT_BACKEND=redis
PILGRIM_RATE_LIMIT_LIMIT=30
PILGRIM_RATE_LIMIT_WINDOW_SECONDS=60

# ── Scrape response cache (config_id, url) ───────────────────────
# redis = shared TTL cache (recommended), memory = per-process, off = none.
# TTL of 0 disables the cache.
PILGRIM_SCRAPE_CACHE_BACKEND=redis
PILGRIM_SCRAPE_CACHE_TTL_SECONDS=600

# ── AI / LLM (OPENAI_COMPATIBLE provider) ────────────────────────
# PILGRIM_LLM_PROVIDER=ollama|openai-compatible
# The OPENAI_COMPATIBLE provider talks to any OpenAI-style /v1 endpoint —
# the manifold gateway here.  Set the model group name and your API key.
PILGRIM_LLM_PROVIDER=ollama
LLM_BASE_URL=https://manifold.gokaygunes.com/gateway/v1
LLM_API_KEY=
LLM_MODEL=

# Sentry (optional)
SENTRY_DSN=
